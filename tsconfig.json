{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "firebase/app": ["./node_modules/@firebase/app/dist/app-public.d.ts"],
      "firebase/auth": ["./node_modules/@firebase/auth/dist/auth-public.d.ts"],
      "firebase/firestore": ["./node_modules/@firebase/firestore/dist/intermediate/firestore/src/api.d.ts"],
      "@firebase/app": ["./node_modules/@firebase/app/dist/app-public.d.ts"],
      "@firebase/auth": ["./node_modules/@firebase/auth/dist/auth-public.d.ts"],
      "@firebase/firestore": ["./node_modules/@firebase/firestore/dist/intermediate/firestore/src/api.d.ts"]
    }
  },
  "exclude": ["node_modules"]
}
