rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isPropertyOwner() {
      return signedIn() && resource.data.ownerId == request.auth.uid;
    }

    function isNewPropertyOwner() {
      return signedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update: if isUser(userId);
      allow delete: if false;

      match /conversations/{conversationId} {
        allow read, create, update, delete: if isUser(userId);

        match /messages/{messageId} {
          allow read, create, update, delete: if isUser(userId);
        }
      }
    }

    match /properties/{propertyId} {
      allow read: if signedIn();
      allow create: if isNewPropertyOwner();
      allow update: if isPropertyOwner()
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if isPropertyOwner();
    }

    match /bookings/{bookingId} {
      allow create: if signedIn()
        && request.resource.data.tenantId == request.auth.uid;
      allow read, update: if signedIn()
        && (resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid);
      allow delete: if false;
    }

    match /repairs/{repairId} {
      allow create: if signedIn()
        && (request.resource.data.tenantId == request.auth.uid
          || request.resource.data.landlordId == request.auth.uid);
      allow read, update: if signedIn()
        && (resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid);
      allow delete: if false;
    }

    match /payments/{paymentId} {
      allow create: if signedIn()
        && (request.resource.data.tenantId == request.auth.uid
          || request.resource.data.landlordId == request.auth.uid);
      allow read, update: if signedIn()
        && (resource.data.tenantId == request.auth.uid
          || resource.data.landlordId == request.auth.uid);
      allow delete: if false;
    }
  }
}
