{
  "expo": {
    "name": "InzuHub",
    "slug": "InzuHub",
    "scheme": "inzuhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
        "package": "com.inzuhub.hub"
    },
    "plugins": [
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow InzuHub to access your photos to set your profile picture.",
          "cameraPermission": "Allow InzuHub to access your camera to take a profile photo."
        }
      ],
      "expo-web-browser"
    ]
  }
}
